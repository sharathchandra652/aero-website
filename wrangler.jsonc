{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aero-website",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  // Required by worker-mailer (Cloudflare TCP sockets + Node built-ins).
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SALES_EMAIL": "aerovillas57@gmail.com",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "587",
    "SMTP_USER": "aerovillas57@gmail.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}