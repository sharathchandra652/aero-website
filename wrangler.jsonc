{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aero-website",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  // Required by worker-mailer (Cloudflare TCP sockets + Node built-ins).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    // The static website (HTML, CSS, JS, images, videos) lives in public/.
    // Server code, config and env templates stay outside it and are never uploaded.
    "directory": "./public",
    "binding": "ASSETS",
    // Only API routes go through the Worker; every other path is served
    // straight from the static asset cache.
    "run_worker_first": ["/api/*"]
  }
}
